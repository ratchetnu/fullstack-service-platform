# Local development database (see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/service_platform

# Database used by the integration tests. It is dropped and recreated on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/service_platform_test

# Session cookies are marked Secure in production by default.
# Set to "false" only when serving a production build over plain HTTP on a non-localhost host.
# SESSION_COOKIE_SECURE=true

# How long a staff session lasts, in hours.
# SESSION_TTL_HOURS=12
